# TripWise Environment Variables
# Copy this file to .env and fill in your values

# 1. Supabase (Postgres Database & Auth)
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Geoapify Places API (Primary POI source)
# Get a free key at https://myprojects.geoapify.com/ (3,000 free credits/day)
GEOAPIFY_API_KEY=your_geoapify_server_key
VITE_GEOAPIFY_API_KEY=your_geoapify_client_key_optional

# 3. Server-side Supabase Service Role Key (Only for admin functions if needed)
# SUPABASE_SERVICE_ROLE_KEY=
